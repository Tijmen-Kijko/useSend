# Copy to a root-owned file outside the repository, for example:
#   /etc/usesend/production.env
# Then chmod 600. Never commit the populated file.

# Explicit images. UseSend production must consume the canonical OCI digest.
USESEND_IMAGE=ghcr.io/tijmen-kijko/usesend@sha256:<digest>
# Keep the immediately previous production digest for application rollback.
USESEND_PREVIOUS_IMAGE=ghcr.io/tijmen-kijko/usesend@sha256:<previous-digest>
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine

# Host persistence. This is intentionally on /home (RAID1 md3), not Docker root.
USESEND_DATA_ROOT=/home/usesend-data
USESEND_BIND_PORT=3400

# Postgres
POSTGRES_USER=usesend
POSTGRES_PASSWORD=<random-long-password>
POSTGRES_DB=usesend
DATABASE_URL=postgresql://usesend:<url-encoded-password>@postgres:5432/usesend

# Redis is isolated on an internal Docker network and has no published port.
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=usesend:

# Public application URL
NEXTAUTH_URL=https://usesend.kijko.nl
NEXTAUTH_SECRET=<random-32-byte-or-longer-secret>

# GitHub OAuth dashboard login
GITHUB_ID=<github-oauth-client-id>
GITHUB_SECRET=<github-oauth-client-secret>

# Only these identities may use the self-hosted dashboard.
ADMIN_EMAIL=<tijmen-email>
SELF_HOSTED_ALLOWED_EMAILS=<tijmen-email>,<david-email>

# Dedicated least-privilege AWS SES/SNS identity
AWS_DEFAULT_REGION=<chosen-ses-region>
AWS_ACCESS_KEY_ID=<usesend-iam-access-key-id>
AWS_SECRET_ACCESS_KEY=<usesend-iam-secret-access-key>

# Abuse controls
API_RATE_LIMIT=10
AUTH_EMAIL_RATE_LIMIT=5

# Data minimization: clear stored email body/header content after N days.
EMAIL_CLEANUP_DAYS=30

# Optional S3-compatible object storage for template/campaign image uploads.
# Leave all unset when image upload is not required.
# S3_COMPATIBLE_ACCESS_KEY=
# S3_COMPATIBLE_SECRET_KEY=
# S3_COMPATIBLE_API_URL=
# S3_COMPATIBLE_PUBLIC_URL=
# S3_COMPATIBLE_BUCKET=

# Resource limits; current host has ample capacity, these prevent one service
# from unexpectedly consuming the whole machine.
POSTGRES_CPU_LIMIT=2
POSTGRES_MEMORY_LIMIT=4g
REDIS_CPU_LIMIT=1
REDIS_MEMORY_LIMIT=2g
USESEND_CPU_LIMIT=4
USESEND_MEMORY_LIMIT=4g
