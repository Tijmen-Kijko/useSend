# Root-owned backup configuration for /etc/usesend/backup.env.
# chmod 600 /etc/usesend/backup.env
#
# This file contains operational secrets/locations and MUST NOT be committed
# after placeholders are replaced.

# Checkout/deployment containing docker/kijko/compose.yml and the backup scripts.
USESEND_REPO_ROOT=/opt/usesend

# Production application environment used by docker compose.
USESEND_PRODUCTION_ENV=/etc/usesend/production.env

# Encrypted off-host Restic repository. Use a dedicated Hetzner Storage Box
# account/sub-account and SSH key restricted to the backup repository.
RESTIC_REPOSITORY=sftp:<storagebox-user>@<storagebox-host>:./usesend-postgres
RESTIC_PASSWORD_FILE=/etc/usesend/restic-password

# Local staging only; successful backups are authoritative in the Restic repo.
USESEND_BACKUP_WORKDIR=/home/usesend-data/backup-staging

# Successful restore verification writes root-only receipts here.
USESEND_BACKUP_RECEIPT_DIR=/home/usesend-data/backup-receipts

# Required external receiver for backup-failure events. USESEND-16 owns the
# final alert destination/dispatch; this script only emits the event.
USESEND_BACKUP_ALERT_WEBHOOK_URL=https://<alert-receiver>/hooks/<secret>
